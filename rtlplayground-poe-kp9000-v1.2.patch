 {
@@ -1884,6 +1923,8 @@ void cmd_parser(void) __banked
 			reset_chip();
 		} else if (cmd_compare(0, "sfp")) {
 			parse_sfp();
+		} else if (cmd_compare(0, "poe")) {
+			parse_poe();
 		} else if (cmd_compare(0, "stat")) {
 			port_stats_print();
 		} else if (cmd_compare(0, "flash") && cmd_words_len == 2) {
