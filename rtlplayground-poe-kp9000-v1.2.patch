 	@echo "ERROR: machine registry is missing (expected $(MACHINE_REGISTRY))." >&2
@@ -255,6 +297,7 @@ SRCS += \
 	uip/uip-fw.c \
 	uip/uip-neighbor.c \
 	uip/uip-split.c
+SRCS += $(POE_SRCS) $(POE_FW_SRC) $(POE_FW_B_SRC)
 
 OBJS = ${SRCS:%.c=$(BUILDDIR)/%.rel}
 MACHINE_OBJ = $(BUILDDIR)/$(MACHINE_SRC:.c=.rel)
@@ -301,12 +344,35 @@ httpd: html_data.h
